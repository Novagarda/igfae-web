# Copy to usc.env (gitignored) and fill in from internal docs.
# Do not put real SSH users, hosts, ports, or server paths in this example.

# --- Production (SSH) ---
PROD_SSH_HOST=
PROD_SSH_PORT=22
PROD_SSH_USER=
PROD_SSH_IDENTITY="${HOME}/.ssh/id_ed25519_igfae"
PROD_WP_PATH=
# Public WordPress URL (used for search-replace into local)
PROD_URL=

# --- Local WP ---
LOCAL_URL=http://localhost:10351
LOCAL_WP_PATH="${HOME}/Local Sites/igfaegit/app/public"
# Local app site id: folder name under Application Support/Local/run/
LOCAL_SITE_ID=

# Optional overrides (auto-detected if empty)
# LOCAL_PHP=
# LOCAL_WP_CLI=/Applications/Local.app/Contents/Resources/extraResources/bin/wp-cli/posix/wp
# LOCAL_MYSQL=

# --- Pre (SSH) ---
PRE_SSH_HOST=
PRE_SSH_PORT=
PRE_SSH_USER=
PRE_SSH_IDENTITY="${HOME}/.ssh/id_ed25519_igfae_pre"
PRE_WP_PATH=
PRE_URL=
