{% import 'macros/macros.twig' as macros %}

{% extends "base.twig" %}

{% block content %}
	<section class="home-wrapper pax-projects">
		<div class="medioalto linha-baixa flex alinha-medio pad persoaltop">
			<h1 class="--font-size-xxxl --font-size-mb-xl azul">{{title}}</h1>
			<button id="btn-filtros" type="button" class="btnnegro">{{ __('Filtro', 'nvgrd') }}</button>
		</div>	


		<div class="pad block-novas --spacing-l-t">
			<div class="grid">
				{% for item in posts %}
					{% include "partials/art-novas.twig" %}
				{% endfor %}
			</div>
		</div>

		<nav id="igfae-pagination" class="reveal">

			<ul class="pagination">
				{% for page in posts.pagination.pages %}
					<li>
						{% if page.link %}
							<a href="{{ page.link }}" class="{{ page.class }}">{{ page.title }}</a>
						{% else %}
							<span class="{{ page.class }}">{{ page.title }}</span>
						{% endif %}
					</li>
				{% endfor %}
			</ul>

		</nav>


		<div class="filtros" id="caixa-filtros">
			<button id="close-filtros" type="button" class="btnclose"></button>
			<div class="filtros-dentro">

				{% if categories %}
				<h5 class="--font-size-xs azul --spacing-s-b">{{_e('Categorías', 'nvgrd')}}</h5>
				
				<ul class="radios">
					{% for category in categories %}
					<li><a href="{{category.link}}" class="btnazul btn-xs">{{category.name}}</a></li>
					{% endfor %}
				</ul>
				{% endif %}

				{% if tags %}
				<div class="--spacing-m-t">
				<h5 class="--font-size-xs azul --spacing-s-b">{{_e('Tags', 'nvgrd')}}</h5>
				
				<ul class="radios">
					{% for tag in tags %}
					<li><a href="{{tag.link}}" class="btnazul btn-xs">{{tag.name}}</a></li>
					{% endfor %}
				</ul>
				</div>
				{% endif %}

			</div>
		</div>			
	</section>

{% endblock %}
