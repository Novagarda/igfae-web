{% import 'macros/macros.twig' as macros %}

{% extends "base.twig" %}

{% block content %}

	{% set anclas = false %}
	{% for bloque in post.meta('content_flexible') %}
		{% if bloque.ancla %}
			{% set anclas = true %}
		{% endif %}
	{% endfor %}

	<div class="page-wrapper">

		<div class="medioalto flex alinha-medio pad persoaltop linha-baixa{{ anclas ? ' con-anclas':''}}{{post.introducion ? ' medioalto-60'}}">
			<div class='safe-space-x2'></div>
			<h1 class="--font-size-xxxl --font-size-mb-xl azul{{post.introducion ? ' --spacing-xl-b'}}">{{post.title}}</h1>
			{% if post.introducion %}
				<div class="intro azul{{ anclas ? ' con-anclas':''}}">{{post.introducion}}</div>
			{% endif %}
		</div>

		{% if anclas %}
			<div class="tags nav-anclas ">
				<div class='tags-inner'>
					{% for bloque in post.meta('content_flexible') %}
						{% if bloque.ancla %}
							<a class="tags-item btnazul btn-xs" href="#{{bloque.ancla|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'})}}">
								{{bloque.ancla}}
							</a>
						{% endif %}
					{% endfor %}
				</div>

				<div class='nav-anclas-bg'></div>
			</div>
		{% endif %}

		{% if post.imaxe_destacada %}
			<div class="medioalto imx">
				{{ macros.imageLazy(post.imaxe_destacada,'img-blue img-centrar', '') }}
			</div>
		{% endif %}

		<div class="bloques-flexibles">
			{% include "blocks/flexible.twig" %}
		</div>


	</div>

{% endblock %}
