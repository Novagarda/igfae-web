{% import 'macros/macros.twig' as macros %}


<section class="block block-banners-grid {{ item.size_check ? ' --big-cards' }} {{ item.filter_check ? ' --has-filter' }} {{item.borde ? ' --border'}}{{item.cor ? ' --' ~ item.cor}}{{item.ancla ? ' anclado'}}" {{item.ancla ? ' id="' ~ item.ancla|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'} ) ~ '"' :'' }}>
	<div class="reveal">
		{% if item.titulo or item.introducion %}
			<div class="grid grid-2 {{item.borde ? ' pad' : ' pad-ceo'}}">
				{% if item.titulo %}
					<div class="titulo-intro left azul --font-size-m">
						{{item.titulo|wpautop}}
					</div>
				{% endif %}
				{% if item.introducion %}
					<div class="right texto">
						{{item.introducion|wpautop}}
					</div>
				{% endif %}
			</div>
		{% endif %}

		<div class="grid grid-tarxetas pad">
			{% for item in item.banner %}
				<article class="card-item --color-set-{{item.__groups_config.color_select.value}} dim reveal">
					{% if item.imaxe %}
						<div class="card-image">{{ macros.imageLazy(item.imaxe,'img-blue img-centrar','@1x') }}</div>
					{% endif %}
					<div class="card-text">
						{% if item.titulo %}
							<h2 class="card-title azul">{{item.titulo}}</h2>
						{% endif %}
						{% if item.subtitulo %}
							<p class="card-subtitle">{{item.subtitulo}}</p>
						{% endif %}
						{% if item.introducion %}
							<p class="card-intro">{{item.introducion}}</p>
						{% endif %}
						{% if item.link %}
							<p class="card-link">
								<a class="stretched-link" href="{{item.link.url}}" target="{{item.link.target}}"></a>
							</p>
						{% endif %}
					</div>
				</article>
			{% endfor %}
		</div>
	</div>

</section>
