<div class="block block-espazo{{item.ancla ? ' anclado'}}{{item.borde ? ' --border'}}{{item.cor ? ' --' ~ item.cor}}" style="--alto-espazo: var(--spacing-{{item.altura_rango}});{{item.altura_mobil ? ' --alto-espazo-mobil: var(--spacing-' ~ item.altura_mobil ~ ')' :' --alto-espazo-mobil: var(--spacing-' ~ item.altura_rango ~ ')' }}" data-espazo="{{item.altura_rango}}"{{item.ancla ? ' id="' ~ item.ancla|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'}) ~ '"':''}}></div>