{% import 'macros/macros.twig' as macros %}

{% extends "base.twig" %}

{% block content %}
	<section class="home-wrapper pax-projects">

	    <div class="medioalto medioalto-60 linha-baixa flex alinha-medio pad persoaltop">
			<h1 class="--font-size-xxxl --font-size-mb-xl azul{{post.introducion ? ' --spacing-xl-b'}}">{{post.title}}</h1>
			{{post.introducion ? '<div class="intro azul">' ~ post.introducion ~ '</div>' :''}}
		</div>

		<div class="pad grid grid-3 block-alumni azul">
			{% for post in posts %}
				<div class="block-alumni-post pad reveal">
					<h3 class="azul --font-size-ms --spacing-xxs-t --spacing-s-b">{{ post.title }}</h3>
					<div class="subtitulo">{{ post.subtitulo }}</div>
					<div class="espacio"></div>
					<div class="intro --font-size-wws">
						{{ post.introducion }}
					</div>
				</div>
			{% endfor %}		
		</div>

		{% include "blocks/flexible.twig" %}

	</section>
{% endblock %}
