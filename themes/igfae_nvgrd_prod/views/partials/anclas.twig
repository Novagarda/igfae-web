{% set anclas = false %}
{% for bloque in post.meta('content_flexible') %}
	{% if bloque.ancla %}
		{% set anclas = true %}
	{% endif %}
{% endfor %}

{% if anclas or internas %}
	<div class="tags nav-anclas ">
		<div class='tags-inner'>
			{% for bloque in post.meta('content_flexible') %}
				{% if bloque.ancla and bloque.colocar_arriba == '1' %}
					<a class="tags-item btnazul btn-xs" href="#{{bloque.ancla|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'})}}">
						{{bloque.ancla}}
					</a>
				{% endif %}
			{% endfor %}

			{% if internas == 'si' %}
				<a class="tags-item btnazul btn-xs" href="#persoal">{{_e('Persoal', 'nvgrd')}}</a>
				<a class="tags-item btnazul btn-xs" href="#publicacions">{{_e('Publicacións', 'nvgrd')}}</a>
				<a class="tags-item btnazul btn-xs" href="#proxectos">{{_e('Proxectos', 'nvgrd')}}</a>
			{% endif %}

			{% if jobs_abertos %}
				<a class="tags-item btnazul btn-xs" href="#ofertas">{{_e('Ofertas', 'nvgrd')}}</a>
			{% endif %}

			{% for bloque in post.meta('content_flexible') %}
				{% if bloque.ancla and bloque.colocar_arriba != '1' %}
					<a class="tags-item btnazul btn-xs" href="#{{bloque.ancla|lower|replace({' ': '-', 'á': 'a', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ñ': 'n'})}}">
						{{bloque.ancla}}
					</a>
				{% endif %}
			{% endfor %}
		</div>

		<div class='nav-anclas-bg'></div>
	</div>
{% endif %}
