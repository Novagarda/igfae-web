{% import 'macros/macros.twig' as macros %}

{% extends "base.twig" %}

{% block content %}
	<section class="home-wrapper pax-projects">
		<div class="medioalto medioalto-60 linha-baixa flex alinha-medio pad persoaltop{{ post.introducion ? ' cabecera-page' : '' }}">
			<h1 class="--font-size-xxxl --font-size-mb-xl azul{{ post.introducion ? ' --spacing-s-b' : '' }}">{{post.title}}</h1>
			{{post.introducion ? '<div class="intro azul">' ~ post.introducion ~ '</div>' :''}}
		</div>

		<div class="pad list-areas-prog">
			{% for area in areas %}
			<div class="area" data-codigo="{{area.codigo}}">
				<h2><a href="{{area.enlace}}" class="carga-loading">{{area.titulo}}</a></h2>

				<div class="programas">
					{% for programa in area.programas %}
						<div class="azul programa">
							<div class="codigo">{{programa.codigo}}</div>
							<h3 class="titulo_prog"><a href="{{programa.link}}" class="carga-loading">{{programa.title}}</a></h3>
							<div class="intro">{{programa.introducion}}</div>
							<div><a href="{{programa.link}}" class="stretched-link btn btnazul --spacing-s-t carga-loading">{{_e('Ver programa', 'nvgrd')}}</a></div>
						</div>
					{% endfor %}
				</div>
			</div>
			{% endfor %}
		<div>
	</section>
{% endblock %}
